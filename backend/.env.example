# Plately Backend Environment Configuration Template
# Copy this file to .env and supply your project-specific values.
# DO NOT commit real secrets, private keys, or credentials to version control.

# Application
APP_NAME="Plately API"
APP_VERSION="0.1.10"
DEBUG=false
LOG_LEVEL="INFO"
STRUCTURED_LOGS=true

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Vision & Cloud Fallback
# Enforced by server-authoritative fair-use daily quotas (app/core/quota.py)
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=

# Clarifai (Optional alternative vision provider)
CLARIFAI_API_KEY=
CLARIFAI_FOOD_MODEL_ID=food-item-recognition

# Monitoring (Optional)
SENTRY_DSN=

# Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://app.theplately.com,https://theplately.com,http://localhost:3000
